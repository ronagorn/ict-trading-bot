# 🔐 ข้อมูลลับ - ห้าม push เด็ดขาด!
.env
*.env
secrets.json

# 🐍 Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# 🌿 Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 📋 Logs (ไฟล์ log ไม่ต้อง push)
logs/
*.log
trading_log*.csv
backtest_results*.csv

# 🖥️ OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 🔧 IDE / Editor
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
*~

# 📦 Build / Dist
dist/
build/
*.egg-info/
*.egg
.eggs/

# 🧪 Test cache
.pytest_cache/
.coverage
htmlcov/

